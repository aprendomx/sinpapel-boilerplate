# Copia este archivo a `.env` y ajusta lo que necesites.
# `.env` está en .gitignore: nunca commitees secretos reales.

# ─── Django ──────────────────────────────────────────────────────────────────
# En producción es obligatorio y no tiene default: el arranque falla sin él.
DJANGO_SECRET_KEY=dev-inseguro-cambiar-en-produccion
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes que pueden hacer POST/PUT/DELETE. Obligatorio si el navegador
# habla con un origen distinto del Host que ve Django (proxy, dominio propio).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
DJANGO_TIME_ZONE=America/Mexico_City
DJANGO_LOG_LEVEL=INFO

# ─── Base de datos ───────────────────────────────────────────────────────────
# El contenedor corre PostgreSQL 16 con PostGIS, pero el engine es `postgres`
# a secas: `postgis://` exige GDAL y GEOS instalados en la máquina que corra el
# backend, y todavía no hay modelos con geometría.
#
# POSTGRES_PORT es el puerto en TU máquina. Si ya tienes un PostgreSQL local en
# el 5432, cámbialo (p. ej. 5433) y ajusta DATABASE_URL para que coincida.
POSTGRES_DB=sinpapel_boilerplate
POSTGRES_USER=sinpapel_boilerplate
POSTGRES_PASSWORD=sinpapel_boilerplate
POSTGRES_PORT=5432
DATABASE_URL=postgres://sinpapel_boilerplate:sinpapel_boilerplate@localhost:5432/sinpapel_boilerplate

# ─── Puertos de la aplicación ────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Solo si sirves la API desde otro origen (entonces configura CORS en Django).
# En desarrollo se deja vacío: el dev server de Vite proxea el backend.
VITE_API_BASE=

# ─── sinpapel ────────────────────────────────────────────────────────────────
# Entrega de webhooks: `inline` (síncrono, solo dev), `outbox` (producción, con
# el worker `sinpapel_webhooks_worker`) o `celery`.
SINPAPEL_WEBHOOKS_BACKEND=outbox

# ─── Producción ──────────────────────────────────────────────────────────────
# Solo para ops/deploy/docker-compose.prod.yml, que falla al arrancar si falta
# cualquiera de estas en vez de tomar un valor por defecto.

# Bundle PEM con las ACs del SAT, montado desde el host. SIN ÉL una firma FIEL
# íntegra se persiste como VALIDA_SIN_CADENA: se verificó la firma, pero no
# quién emitió el certificado.
FIEL_CA_BUNDLE=/etc/sinpapel/sat-ca-bundle.pem

# Cada cuánto se evalúan los plazos de SLA. El motor no es event-driven: sin
# este servicio ninguna solicitud vence nunca.
SLA_INTERVALO_SEGUNDOS=3600

# Retención de respaldos, en días (ops/deploy/backup.sh).
RETENCION_DIAS=14

# Secretos HMAC de los proveedores entrantes, en formato clave=valor.
# Ejemplo: SINPAPEL_WEBHOOKS_INBOUND_SECRETS=proveedor_x=abc123,otro=def456
SINPAPEL_WEBHOOKS_INBOUND_SECRETS=

# Ruta al bundle PEM con las ACs del SAT. Obligatorio en producción con FIEL:
# sin él, una firma íntegra se persiste como VALIDA_SIN_CADENA (no se verificó
# quién emitió el certificado).
SINPAPEL_FIEL_TRUSTED_CA_BUNDLE=/etc/sinpapel/sat-ca-bundle.pem
